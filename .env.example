# ==========================================
# SISTEMA-CURRICULO — AMBIENTE DE DESENVOLVIMENTO LOCAL
# Arquivo de exemplo seguro (.env.example)
# Copie este arquivo para .env e ajuste os valores se necessário.
# NUNCA envie o arquivo .env com credenciais reais para o Git!
# ==========================================

# Aplicação
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

# Banco de Dados Relacional (PostgreSQL / Docker)
DB_HOST=db
DB_PORT=5432
DB_NAME=sistema_curriculo_dev
DB_USER=curriculo_app_user
DB_PASSWORD=dev_secret_password_local

# Integração Grupo 2 (CV Matcher - Engine de Vagas)
GRUPO2_API_URL=http://host.docker.internal:8000
GRUPO2_API_TIMEOUT_MS=5000
GRUPO2_DEFAULT_LIMIT=10

# Segurança e Autenticação (Middleware de Sessão)
JWT_SECRET=dev_local_jwt_secret_token_chave_segura_12345
SESSION_TTL_HOURS=24
