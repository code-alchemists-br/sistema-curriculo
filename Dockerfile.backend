FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY src/backend/requirements-teste-ia.txt src/backend/requirements-teste-ia.txt
RUN python -m pip install --no-cache-dir -r src/backend/requirements-teste-ia.txt

COPY alembic.ini ./
COPY src/backend/ src/backend/

RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin appuser

USER 10001

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
